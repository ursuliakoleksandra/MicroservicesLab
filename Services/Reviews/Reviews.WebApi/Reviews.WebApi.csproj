<Project Sdk="Microsoft.NET.Sdk.Web">
  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.9.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- Presentation залежить від Application і Infrastructure (останнє — лише для реєстрації залежностей при старті) -->
    <ProjectReference Include="..\Reviews.Application\Reviews.Application.csproj" />
    <ProjectReference Include="..\Reviews.Infrastructure\Reviews.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Лаб. 06: gRPC-сервер (містить Google.Protobuf і Grpc.Tools) -->
    <PackageReference Include="Grpc.AspNetCore" Version="2.71.0" />
    <!-- Лаб. 07: gRPC Health Checking Protocol (перевірка MongoDB — власна легка, див. MongoHealthCheck) -->
    <PackageReference Include="Grpc.AspNetCore.HealthChecks" Version="2.71.0" />
    <Protobuf Include="Protos\reviews.proto" GrpcServices="Server" />
  </ItemGroup>
  <ItemGroup>
    <!-- Лаб. 05: спільні налаштування логування, трасування, health checks, service discovery -->
    <ProjectReference Include="..\..\..\Platform.ServiceDefaults\Platform.ServiceDefaults.csproj" />
  </ItemGroup>
</Project>
