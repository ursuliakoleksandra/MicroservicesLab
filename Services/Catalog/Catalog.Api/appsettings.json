{
  "ConnectionStrings": {
    "CatalogDb": "Server=localhost,1433;Database=CatalogDb;User Id=sa;Password=Your_strong_Passw0rd;TrustServerCertificate=True;Connect Timeout=15"
  },
  "Database": {
    "MigrateOnStartup": true,
    "Seed": true,
    "IgnorePendingModelChangesWarning": true
  },
  "Diagnostics": {
    "LogSqlCommands": true
  },
  "AutoMapper": {
    "LicenseKey": ""
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "logs/catalog-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} [{Level:u3}] ({CorrelationId}) {RequestPath} {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
