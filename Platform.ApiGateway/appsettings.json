{
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "aggregator": {
        "ClusterId": "aggregator",
        "Order": 1,
        "Match": {
          "Path": "/api/aggregator/{**catch-all}"
        },
        "AuthorizationPolicy": "authenticated"
      },
      "orders": {
        "ClusterId": "orders",
        "MaxRequestBodySize": 1048576,
        "Metadata": {
          "Team": "orders",
          "Version": "v1"
        },
        "Match": {
          "Path": "/api/orders/{**catch-all}"
        },
        "AuthorizationPolicy": "authenticated"
      },
      "customers": {
        "ClusterId": "orders",
        "Metadata": {
          "Team": "orders",
          "Version": "v1"
        },
        "Match": {
          "Path": "/api/customers/{**catch-all}"
        },
        "AuthorizationPolicy": "authenticated"
      },
      "order-products": {
        "ClusterId": "orders",
        "Metadata": {
          "Team": "orders",
          "Version": "v1"
        },
        "Match": {
          "Path": "/api/order-products/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/products/{**catch-all}"
          }
        ],
        "AuthorizationPolicy": "authenticated"
      },
      "catalog": {
        "ClusterId": "catalog",
        "Metadata": {
          "Team": "catalog",
          "Version": "v1"
        },
        "Match": {
          "Path": "/api/products/{**catch-all}"
        },
        "AuthorizationPolicy": "authenticated"
      },
      "categories": {
        "ClusterId": "catalog",
        "Match": {
          "Path": "/api/categories/{**catch-all}"
        },
        "AuthorizationPolicy": "authenticated"
      },
      "brands": {
        "ClusterId": "catalog",
        "Match": {
          "Path": "/api/brands/{**catch-all}"
        },
        "AuthorizationPolicy": "authenticated"
      },
      "reviews": {
        "ClusterId": "reviews",
        "Metadata": {
          "Team": "reviews",
          "Version": "v1"
        },
        "Match": {
          "Path": "/api/reviews/{**catch-all}"
        },
        "AuthorizationPolicy": "authenticated"
      },
      "discussions": {
        "ClusterId": "reviews",
        "Match": {
          "Path": "/api/discussions/{**catch-all}"
        },
        "AuthorizationPolicy": "authenticated"
      },
      "auth-public": {
        "ClusterId": "auth",
        "Order": 0,
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/auth/{**catch-all}",
          "Methods": [
            "POST"
          ]
        },
        "Metadata": {
          "Team": "auth"
        }
      },
      "auth-protected": {
        "ClusterId": "auth",
        "Order": 2,
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/auth/{**catch-all}"
        },
        "Metadata": {
          "Team": "auth"
        }
      },
      "users": {
        "ClusterId": "auth",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/users/{**catch-all}"
        },
        "Metadata": {
          "Team": "auth"
        }
      },
      "payments": {
        "ClusterId": "payments",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/api/payments/{**catch-all}"
        },
        "Metadata": {
          "Team": "payments"
        }
      }
    },
    "Clusters": {
      "aggregator": {
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        },
        "Destinations": {
          "d1": {
            "Address": "http://aggregator"
          }
        }
      },
      "orders": {
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        },
        "Destinations": {
          "d1": {
            "Address": "http://orders-api"
          }
        }
      },
      "catalog": {
        "LoadBalancingPolicy": "RoundRobin",
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        },
        "Destinations": {
          "d1": {
            "Address": "http://catalog-api"
          }
        }
      },
      "reviews": {
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        },
        "Destinations": {
          "d1": {
            "Address": "http://reviews-api"
          }
        }
      },
      "auth": {
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        },
        "Destinations": {
          "d1": {
            "Address": "http://auth-api"
          }
        }
      },
      "payments": {
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        },
        "Destinations": {
          "d1": {
            "Address": "http://payments-api"
          }
        }
      }
    }
  }
}
