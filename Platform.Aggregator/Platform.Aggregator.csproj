<Project Sdk="Microsoft.NET.Sdk.Web">
  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.9.0" />

    <!-- Лаб. 06: gRPC-клієнти з DI (Grpc.Net.ClientFactory містить Grpc.Net.Client), генерація клієнтського коду з .proto -->
    <PackageReference Include="Grpc.Net.ClientFactory" Version="2.71.0" />
    <PackageReference Include="Google.Protobuf" Version="3.31.1" />
    <PackageReference Include="Grpc.Tools" Version="2.72.0" PrivateAssets="All" />

    <!-- кеш агрегованих відповідей у Redis -->
    <PackageReference Include="Aspire.StackExchange.Redis.DistributedCaching" Version="9.5.0" />

    <!-- Лаб. 07: health checks — gRPC Health Checking Protocol (клієнт) і Redis -->
    <PackageReference Include="Grpc.HealthCheck" Version="2.71.0" />
    <PackageReference Include="AspNetCore.HealthChecks.Redis" Version="9.0.0" />
  </ItemGroup>

  <!-- ті самі .proto-файли, що й у сервісах, але лише КЛІЄНТСЬКА частина (контракт один — копій немає) -->
  <ItemGroup>
    <Protobuf Include="..\Services\Catalog\Catalog.Api\Protos\catalog.proto" GrpcServices="Client" Link="Protos\catalog.proto" />
    <Protobuf Include="..\Services\Orders\Orders.Api\Protos\orders.proto" GrpcServices="Client" Link="Protos\orders.proto" />
    <Protobuf Include="..\Services\Reviews\Reviews.WebApi\Protos\reviews.proto" GrpcServices="Client" Link="Protos\reviews.proto" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Platform.ServiceDefaults\Platform.ServiceDefaults.csproj" />
    <ProjectReference Include="..\Platform.Caching\Platform.Caching.csproj" />
    <ProjectReference Include="..\Platform.Security\Platform.Security.csproj" />
  </ItemGroup>
</Project>
